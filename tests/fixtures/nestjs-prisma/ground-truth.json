    ["src/users/users.controller.ts", "src/auth/auth.guard.ts"],
    ["src/users/users.controller.ts", "src/common/pagination.ts"],
    ["src/users/users.service.ts", "src/prisma/prisma.service.ts"],
    ["src/users/users.service.ts", "src/posts/posts.service.ts"],
    ["src/users/users.service.ts", "src/common/pagination.ts"],
    ["src/posts/posts.module.ts", "src/posts/posts.controller.ts"],
