{
  "name": "nestjs-prisma",
  "frameworks": ["nestjs"],
  "languages": ["typescript"],
  "routes": [
    { "method": "GET", "path": "/users", "handler": "findAll", "handlerFile": "src/users/users.controller.ts" },
    { "method": "GET", "path": "/users/:id", "handler": "findOne", "handlerFile": "src/users/users.controller.ts" },
    { "method": "POST", "path": "/users", "handler": "create", "handlerFile": "src/users/users.controller.ts", "middleware": ["AuthGuard"] },
    { "method": "GET", "path": "/posts", "handler": "findPublished", "handlerFile": "src/posts/posts.controller.ts" },
    { "method": "GET", "path": "/posts/:id/comments", "handler": "comments", "handlerFile": "src/posts/posts.controller.ts" },
    { "method": "POST", "path": "/posts", "handler": "create", "handlerFile": "src/posts/posts.controller.ts", "middleware": ["AuthGuard"] },
    { "method": "DELETE", "path": "/posts/:id", "handler": "remove", "handlerFile": "src/posts/posts.controller.ts", "middleware": ["AuthGuard"] }
  ],
  "entities": [
    { "name": "User", "fields": ["id", "email", "name", "createdAt"] },
    { "name": "Post", "fields": ["id", "title", "body", "published", "authorId"] },
    { "name": "Comment", "fields": ["id", "text", "postId"] }
  ],
  "relations": [{ "from": "Post", "to": "User" }, { "from": "Comment", "to": "Post" }],
  "imports": [
