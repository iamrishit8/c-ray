    ["src/posts/posts.controller.ts", "src/auth/auth.guard.ts"],
    ["src/posts/posts.service.ts", "src/prisma/prisma.service.ts"],
    ["src/posts/posts.service.ts", "src/users/users.service.ts"]
  ],
  "importsExact": true,
  "cycle": ["src/users/users.service.ts", "src/posts/posts.service.ts"],
  "layeringViolation": { "file": "src/posts/posts.controller.ts", "contains": "this.prisma.comment.findMany" },
  "secret": { "file": "src/auth/constants.ts", "contains": "API_KEY" },
