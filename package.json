{
  "name": "imex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "imex: understand any unfamiliar codebase, entirely in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench:l1l2": "vitest run tests/bench/l1-vs-l2.test.ts",
    "bench:scale": "vitest run --config vitest.scale.config.ts",
    "gen:synthetic": "node scripts/gen-synthetic.mjs",
    "postinstall": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "bench:git": "vitest run tests/bench/git-real.test.ts",
    "audit:contrast": "node scripts/contrast-audit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource/geist-mono": "^5.3.0",
    "buffer": "^6.0.3",
    "cytoscape": "^3.35.0",
    "cytoscape-elk": "^2.4.0",
    "cytoscape-fcose": "^2.2.0",
    "elkjs": "^0.12.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "isomorphic-git": "^1.44.15",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "5.9",
    "web-tree-sitter": "^0.22.6",
    "zustand": "^5.1.0"
  }
}
